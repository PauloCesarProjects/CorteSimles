# Variáveis de ambiente para desenvolvimento local e Vercel
# Copie este arquivo para .env.local e preencha com seus valores

# Supabase - https://supabase.com
# 1. Crie uma conta em supabase.com
# 2. Crie um novo projeto
# 3. Vá em Settings > API para encontrar a URL e chave anon
SUPABASE_URL=sua_url_supabase_aqui
SUPABASE_KEY=sua_chave_supabase_aqui
